cabal-version: 3.0
name: perf-circuits-parser
version: 0.1.0.0
license: BSD-3-Clause
copyright: Tony Day (c) 2025
category: performance
author: Tony Day
maintainer: tonyday567@gmail.com
synopsis: Benchmark harness for markup-parse.
description:
  Benchmarks for the @markup-parse@ markup layer, over a calibrated
  synthetic corpus plus real chart-svg SVG artifacts.

  Two harnesses measure identical closures over identical inputs:

  * @markup-criterion@ — the criterion baseline.
  * @markup-meter@ — the same work measured with circuits-meter's @ticksN@,
    to cross-check circuits-meter against its main competitor.

build-type: Simple
tested-with: ghc ==9.14.1

common ghc-options-exe-stanza
  ghc-options:
    -fforce-recomp
    -funbox-strict-fields
    -rtsopts
    -threaded
    -with-rtsopts=-N

common ghc-options-stanza
  ghc-options:
    -Wall
    -Wcompat
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wredundant-constraints

common bench-deps
  build-depends:
    base >=4.18 && <5,
    bytestring >=0.12 && <0.13,
    containers >=0.6 && <0.9,
    deepseq >=1.5 && <1.6,
    markup-parse >=0.3 && <0.4,
    markup-parse-legacy >=0.2 && <0.3,
    these >=1.2 && <1.3,

benchmark markup-criterion
  import: ghc-options-exe-stanza
  import: ghc-options-stanza
  import: bench-deps
  default-language: GHC2024
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    Corpus
    Workload
  hs-source-dirs: bench
  build-depends:
    criterion >=1.6 && <1.7,

benchmark markup-meter
  import: ghc-options-exe-stanza
  import: ghc-options-stanza
  import: bench-deps
  default-language: GHC2024
  type: exitcode-stdio-1.0
  main-is: Meter.hs
  other-modules:
    Corpus
    Workload
  hs-source-dirs: bench
  build-depends:
    circuits-meter >=0.1 && <0.2,
