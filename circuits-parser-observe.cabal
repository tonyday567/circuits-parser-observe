cabal-version: 3.0
name: circuits-parser-observe
version: 0.1.0.0
license: BSD-3-Clause
copyright: Tony Day (c) 2025
category: performance
author: Tony Day
maintainer: tonyday567@gmail.com
synopsis: Machine observation for the circuits-parser substrate
description:
  Inward study of the circuits-parser substrate: measurement, gap diagnosis,
  and machine specification. This package is disconnected from the core
  @circuits-parser@ library so that in-house dev tools and measurement
  dependencies do not burden the published library build.

  The benchmark stanzas remain as external measurement plumbing (comparisons
  with other libraries); the @circuits-parser-observe@ executable is the
  library's own machine observation.

build-type: Simple
tested-with: ghc ==9.14.1

common ghc-options-exe-stanza
  ghc-options:
    -fforce-recomp
    -funbox-strict-fields
    -rtsopts
    -threaded
    -with-rtsopts=-N

common ghc-options-stanza
  ghc-options:
    -Wall
    -Wcompat
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wredundant-constraints

common bench-deps
  build-depends:
    base >=4.18 && <5,
    bytestring >=0.12 && <0.13,
    containers >=0.6 && <0.9,
    deepseq >=1.5 && <1.6,
    markup-parse >=0.3 && <0.4,
    markup-parse-legacy >=0.2 && <0.3,
    these >=1.2 && <1.3,

executable circuits-parser-observe
  import: ghc-options-exe-stanza
  import: ghc-options-stanza
  default-language: GHC2024
  main-is: observe.hs
  hs-source-dirs: app
  build-depends:
    base >=4.18 && <5,
    bytestring >=0.12 && <0.13,
    circuits-parser >=0.1 && <0.2,
    circuits-meter >=0.1 && <0.2,
    deepseq >=1.5 && <1.6,

benchmark markup-criterion
  import: ghc-options-exe-stanza
  import: ghc-options-stanza
  import: bench-deps
  default-language: GHC2024
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    Corpus
    Workload
  hs-source-dirs: bench
  build-depends:
    criterion >=1.6 && <1.7,

benchmark markup-meter
  import: ghc-options-exe-stanza
  import: ghc-options-stanza
  import: bench-deps
  default-language: GHC2024
  type: exitcode-stdio-1.0
  main-is: Meter.hs
  other-modules:
    Corpus
    Workload
  hs-source-dirs: bench
  build-depends:
    circuits-meter >=0.1 && <0.2,

test-suite machinarium
  import: ghc-options-exe-stanza
  import: ghc-options-stanza
  import: bench-deps
  default-language: GHC2024
  type: exitcode-stdio-1.0
  main-is: Machinarium.hs
  hs-source-dirs:
    test
    bench
  build-depends:
    circuits-meter >=0.1 && <0.2,
    containers >=0.6 && <0.9,
